[node name="PauseMenu" type="CanvasLayer"]
visible = false
layer = 20
process_mode = 3
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.08, 0.12, 0.72)

[node name="CenterContainer" type="CenterContainer" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PausePanel" type="PanelContainer" parent="Root/CenterContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="PauseBox" type="VBoxContainer" parent="Root/CenterContainer/PausePanel"]
theme_override_constants/separation = 14

[node name="PauseTitle" type="Label" parent="Root/CenterContainer/PausePanel/PauseBox"]
horizontal_alignment = 1
text = "暂停"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.35, 0.16, 0.13, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 44

[node name="ContinueButton" type="Button" parent="Root/CenterContainer/PausePanel/PauseBox"]
custom_minimum_size = Vector2(300, 54)
theme_override_styles/normal = SubResource("StyleBoxFlat_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_normal")
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.2, 0.11, 0.09, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 24
text = "继续游戏"

[node name="SettingsButton" type="Button" parent="Root/CenterContainer/PausePanel/PauseBox"]
